background-opacity = 0.80
background-blur = 20
window-decoration = none

window-theme = ghostty

palette = 0=#06080f
palette = 1=#fca5a5
palette = 2=#86efac
palette = 3=#fcd34d
palette = 4=#7fb4ca
palette = 5=#c4b5fd
palette = 6=#5c6170
palette = 7=#f3f6f9
palette = 8=#1e293b
palette = 9=#eb6f92
palette = 10=#a6e3a1
palette = 11=#fde68a
palette = 12=#a3d4d5
palette = 13=#e8a0bf
palette = 14=#94a3b8
palette = 15=#ffffff

background = 000000
foreground = f3f6f9
cursor-color = 7465a1
selection-background = 7465a1
selection-foreground = f3f6f9

font-family = IosevkaTerm NF
font-family = Segoe UI Emoji
font-codepoint-map = U+1F1E6-U+1F1FF=Noto Color Emoji
font-size = 18
window-padding-color = extend
window-step-resize = true
window-padding-balance = true

### Mac Alt Fix
macos-option-as-alt = left

keybind = alt+left=unbind
keybind = alt+right=unbind

### KeyBindings
keybind = global:alt+z=toggle_quick_terminal
keybind = alt+f=toggle_split_zoom

keybind = alt+v=new_split:right
keybind = alt+d=new_split:down

keybind = ctrl+shift+j=resize_split:up,10
keybind = ctrl+shift+k=resize_split:down,10
keybind = ctrl+shift+h=resize_split:left,10
keybind = ctrl+shift+l=resize_split:right,10

keybind = alt+k=goto_split:up
keybind = alt+j=goto_split:down
keybind = alt+h=goto_split:left
keybind = alt+l=goto_split:right

keybind = cmd+k=clear_screen

keybind = alt+s=write_screen_file:paste

### tmux
### command = "tmux new-session -A -s main"
keybind = shift+enter=text:\x1b\r

### background-image = /home/kuro/Desktop/ファイル/画像/gastly.png
background-image-position = bottom-right
background-image-fit = none
background-image-opacity = 0.3
background-image-repeat = false
